#!/bin/sh
# Re-scan every commit about to leave the machine (catches `commit --no-verify`).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"               # new branch: everything not yet pushed
  else
    range="$remote_sha..$local_sha"
  fi
  python3 "$root/tools/secret_guard.py" --range "$range" || exit 1
done
